# Copy this file to .env in the repository root; do not commit .env.
# Generate a fresh key: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Create an empty MySQL database and use your own local account.
DB_NAME=mall
DB_USER=mall_user
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/1
# Leave blank only if your local Redis has no password.
REDIS_PASSWORD=
REDIS_KEY_PREFIX=mall
